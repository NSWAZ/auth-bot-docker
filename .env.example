# Local development only. Never commit real values.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_NIS_GUILD_ID=
DISCORD_RECRUIT_GUILD_ID=
SEAT_TOKEN=
LOG_LEVEL=INFO
# Optional: Discord user ID applicants are told to contact on errors (default: a recruiter)
# RECRUIT_ERROR_CONTACT_ID=

INTEL_ARCHIVE_URL=http://127.0.0.1:8000
INTEL_ARCHIVE_TOKEN=
# INTEL_ARCHIVE_TOKEN_FILE=/run/secrets/auth_bot_intel_archive_token
# POST waits while the archive downloads every attachment; every POST/GET attempt and wait must fit in Discord's 15 minutes.
# INTEL_ARCHIVE_TIMEOUT_MS=180000
# INTEL_ARCHIVE_GET_TIMEOUT_MS=30000
# INTEL_ARCHIVE_RETRIES=2
# INTEL_ARCHIVE_RETRY_DELAY_MS=2000
# Keep equal to the archive's ARCHIVE_MAX_REQUEST_BYTES / ARCHIVE_ATTACHMENT_HOSTS / ARCHIVE_ALLOWED_MIME_TYPES / ARCHIVE_MAX_ATTACHMENT_BYTES.
# INTEL_ARCHIVE_MAX_REQUEST_BYTES=16777216
# INTEL_ARCHIVE_ATTACHMENT_HOSTS=cdn.discordapp.com,media.discordapp.net
# INTEL_ARCHIVE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain
# INTEL_ARCHIVE_MAX_ATTACHMENT_BYTES=26214400

# BAN_LIST_FILE=./ban-list.example.json
